WEBDAV_BASE=http://your-server/zotero
WEBDAV_USER=your_username
WEBDAV_PASS=your_password
PORT=3001

# Password protection for the web UI (set both to enable)
APP_USER=your_username
APP_PASS=your_password

# GitHub webhook secret — generate with: openssl rand -hex 32
WEBHOOK_SECRET=

# PM2 process name (used by webhook to restart the app)
PM2_APP_NAME=zotero-timeline
